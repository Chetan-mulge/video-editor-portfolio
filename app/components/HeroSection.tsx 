"use client";

import { useEffect, useRef } from "react";

interface Char {
  ch: string;
  ox: number;
  oy: number;
  x: number;
  y: number;
  vx: number;
  vy: number;
  w: number;
  sz: number;
}

interface Orb {
  fx: number;
  fy: number;
  r: number;
  c: [number, number, number];
  spd: number;
  ph: number;
}

interface Particle {
  x: number;
  y: number;
  r: number;
  vy: number;
  vx: number;
  a: number;
}

export default function HeroSection() {
  const heroRef = useRef<HTMLDivElement>(null);
  const bgRef = useRef<HTMLCanvasElement>(null);
  const nameRef = useRef<HTMLCanvasElement>(null);
  const partRef = useRef<HTMLCanvasElement>(null);
  const mouseRef = useRef({ x: 0, y: 0, sx: 0, sy: 0 });
  const rafRef = useRef<number>(0);

  useEffect(() => {
    const hero = heroRef.current;
    const bgC = bgRef.current;
    const nmC = nameRef.current;
    const ptC = partRef.current;
    if (!hero || !bgC || !nmC || !ptC) return;

    const bgX = bgC.getContext("2d")!;
    const nmX = nmC.getContext("2d")!;
    const ptX = ptC.getContext("2d")!;

    let W = 0, H = 0;
    let chars: Char[] = [];
    let tick = 0;

    // ── GRAIN TEXTURE ──────────────────────────────────────────────────────────
    const gC = document.createElement("canvas");
    gC.width = gC.height = 512;
    const gX = gC.getContext("2d")!;
    const gd = gX.createImageData(512, 512);
    for (let i = 0; i < gd.data.length; i += 4) {
      const v = Math.random() * 255;
      gd.data[i] = gd.data[i + 1] = gd.data[i + 2] = v;
      gd.data[i + 3] = Math.random() * 14 + 2;
    }
    gX.putImageData(gd, 0, 0);

    // ── ORBS ───────────────────────────────────────────────────────────────────
    const orbs: Orb[] = [
      { fx: 0.1,  fy: 0.2,  r: 260, c: [255, 70,  20],  spd: 0.7, ph: 0   },
      { fx: 0.85, fy: 0.15, r: 300, c: [130, 60,  255], spd: 0.5, ph: 2.1 },
      { fx: 0.5,  fy: 0.82, r: 240, c: [20,  130, 220], spd: 0.6, ph: 1.3 },
      { fx: 0.9,  fy: 0.75, r: 180, c: [255, 150, 30],  spd: 0.4, ph: 3.5 },
      { fx: 0.22, fy: 0.78, r: 200, c: [20,  200, 130], spd: 0.55,ph: 0.9 },
    ];

    // ── PARTICLES ──────────────────────────────────────────────────────────────
    let particles: Particle[] = [];
    function buildParticles() {
      particles = Array.from({ length: 50 }, () => ({
        x: Math.random() * W,
        y: Math.random() * H,
        r: Math.random() * 1.2 + 0.2,
        vy: -(Math.random() * 0.45 + 0.12),
        vx: (Math.random() - 0.5) * 0.28,
        a: Math.random() * 0.22 + 0.04,
      }));
    }

    // ── NAME CHARS ─────────────────────────────────────────────────────────────
    function buildChars() {
      chars = [];
      const LINE1 = "CHETAN";
      const LINE2 = "MULGE";
      const sz = Math.min(W * 0.148, 130);

      nmX.font = `900 ${sz}px 'Helvetica Neue', Helvetica, Arial, sans-serif`;
      const w1 = nmX.measureText(LINE1).width;
      const w2 = nmX.measureText(LINE2).width;

      function addWord(word: string, y: number, startX: number) {
        nmX.font = `900 ${sz}px 'Helvetica Neue', Helvetica, Arial, sans-serif`;
        let cx = startX;
        for (const ch of word) {
          const cw = nmX.measureText(ch).width;
          chars.push({
            ch, sz,
            ox: cx + cw / 2, oy: y,
            x: cx + cw / 2,  y,
            vx: 0, vy: 0, w: cw,
          });
          cx += cw;
        }
      }

      const centerY = H / 2;
      addWord(LINE1, centerY - sz * 0.55, (W - w1) / 2);
      addWord(LINE2, centerY + sz * 0.55, (W - w2) / 2);
    }

    // ── RESIZE ─────────────────────────────────────────────────────────────────
    function resize() {
      const r = hero!.getBoundingClientRect()
      W = r.width;
      H = r.height;
      [bgC, nmC, ptC].forEach((c) => {
      if (!c) return;
      c.width = W;
      c.height = H;
      });
      mouseRef.current.x  = W / 2;
      mouseRef.current.y  = H / 2;
      mouseRef.current.sx = W / 2;
      mouseRef.current.sy = H / 2;
      buildChars();
      buildParticles();
    }
    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(hero!)

    // ── MOUSE ──────────────────────────────────────────────────────────────────
    const onMove = (e: MouseEvent) => {
      const r = hero!.getBoundingClientRect()
      mouseRef.current.x = e.clientX - r.left;
      mouseRef.current.y = e.clientY - r.top;
    };
    const onLeave = () => {
      mouseRef.current.x = W / 2;
      mouseRef.current.y = H / 2;
    };
    hero.addEventListener("mousemove", onMove);
    hero.addEventListener("mouseleave", onLeave);

    // ── DRAW BACKGROUND ────────────────────────────────────────────────────────
    function drawBg() {
      const { sx, sy } = mouseRef.current;
      bgX.clearRect(0, 0, W, H);

      // Base
      bgX.fillStyle = "#07060a";
      bgX.fillRect(0, 0, W, H);

      // Orbs
      const px = (sx - W / 2) / W;
      const py = (sy - H / 2) / H;
      for (const o of orbs) {
        const wave = Math.sin(tick * 0.007 + o.ph) * 0.035 * o.spd;
        const ox = o.fx * W + wave * W + px * 65 * (o.r / 260);
        const oy =
          o.fy * H +
          Math.cos(tick * 0.005 + o.ph) * 0.03 * H * o.spd +
          py * 45 * (o.r / 260);
        const g = bgX.createRadialGradient(ox, oy, 0, ox, oy, o.r);
        g.addColorStop(0,   `rgba(${o.c[0]},${o.c[1]},${o.c[2]},0.11)`);
        g.addColorStop(0.45,`rgba(${o.c[0]},${o.c[1]},${o.c[2]},0.04)`);
        g.addColorStop(1,   `rgba(${o.c[0]},${o.c[1]},${o.c[2]},0)`);
        bgX.fillStyle = g;
        bgX.fillRect(0, 0, W, H);
      }

      // Grain
      bgX.globalAlpha = 0.55;
      bgX.fillStyle = bgX.createPattern(gC, "repeat")!;
      bgX.fillRect(0, 0, W, H);
      bgX.globalAlpha = 1;

      // Scanlines
      bgX.strokeStyle = "rgba(255,255,255,0.013)";
      bgX.lineWidth = 1;
      for (let y = 0; y < H; y += 4) {
        bgX.beginPath();
        bgX.moveTo(0, y);
        bgX.lineTo(W, y);
        bgX.stroke();
      }

      // Vignette
      const v = bgX.createRadialGradient(W / 2, H / 2, H * 0.1, W / 2, H / 2, H * 0.9);
      v.addColorStop(0, "rgba(0,0,0,0)");
      v.addColorStop(1, "rgba(0,0,0,0.78)");
      bgX.fillStyle = v;
      bgX.fillRect(0, 0, W, H);
    }

    // ── DRAW PARTICLES ─────────────────────────────────────────────────────────
    function drawParticles() {
      const { sx, sy } = mouseRef.current;
      ptX.clearRect(0, 0, W, H);
      const px = (sx - W / 2) / W;
      const py = (sy - H / 2) / H;
      for (const p of particles) {
        p.y += p.vy;
        p.x += p.vx;
        if (p.y < -2) { p.y = H + 2; p.x = Math.random() * W; }
        if (p.x < 0)  p.x = W;
        if (p.x > W)  p.x = 0;
        ptX.beginPath();
        ptX.arc(p.x + px * 20, p.y + py * 14, p.r, 0, Math.PI * 2);
        ptX.fillStyle = `rgba(255,255,255,${p.a})`;
        ptX.fill();
      }
    }

    // ── DRAW NAME ──────────────────────────────────────────────────────────────
    function drawName() {
      const { x: mx, y: my } = mouseRef.current;
      nmX.clearRect(0, 0, W, H);

      for (const c of chars) {
        const dx = c.x - mx;
        const dy = c.y - my;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const R = 110;
        if (dist < R && dist > 0.1) {
          const f = ((R - dist) / R) * 22;
          c.vx += (dx / dist) * f;
          c.vy += (dy / dist) * f;
        }
        c.vx += (c.ox - c.x) * 0.13;
        c.vy += (c.oy - c.y) * 0.13;
        c.vx *= 0.7;
        c.vy *= 0.7;
        c.x += c.vx;
        c.y += c.vy;
      }

      nmX.textBaseline = "middle";
      for (const c of chars) {
        nmX.font = `900 ${c.sz}px 'Helvetica Neue', Helvetica, Arial, sans-serif`;
        const dd = Math.sqrt((c.x - c.ox) ** 2 + (c.y - c.oy) ** 2);
        const t = Math.min(dd / 80, 1);

        if (t > 0.05) {
          nmX.shadowColor = `rgba(255,${Math.round(80 * (1 - t))},${Math.round(30 * (1 - t))},${t * 0.9})`;
          nmX.shadowBlur = 32 * t;
        } else {
          nmX.shadowColor = "rgba(255,255,255,0.04)";
          nmX.shadowBlur = 10;
        }

        const rr = 255;
        const gg = Math.round(255 - t * 195);
        const bb = Math.round(255 - t * 228);
        nmX.fillStyle = `rgb(${rr},${gg},${bb})`;
        nmX.fillText(c.ch, c.x - c.w / 2, c.y);
      }
      nmX.shadowBlur = 0;
    }

    // ── LOOP ───────────────────────────────────────────────────────────────────
    function loop() {
      tick++;
      const m = mouseRef.current;
      m.sx += (m.x - m.sx) * 0.07;
      m.sy += (m.y - m.sy) * 0.07;
      drawBg();
      drawParticles();
      drawName();
      rafRef.current = requestAnimationFrame(loop);
    }
    loop();

    return () => {
      cancelAnimationFrame(rafRef.current);
      hero.removeEventListener("mousemove", onMove);
      hero.removeEventListener("mouseleave", onLeave);
      ro.disconnect();
    };
  }, []);

  return (
    <section
      ref={heroRef}
      className="hero-section"
      style={{
        position: "relative",
        width: "100%",
        height: "100svh",
        overflow: "hidden",
        background: "#07060a",
        cursor: "none",
      }}
    >
      {/* Canvas layers */}
      <canvas
        ref={bgRef}
        style={{ position: "absolute", inset: 0, width: "100%", height: "100%", zIndex: 1 }}
      />
      <canvas
        ref={partRef}
        style={{ position: "absolute", inset: 0, width: "100%", height: "100%", zIndex: 2, pointerEvents: "none" }}
      />
      <canvas
        ref={nameRef}
        style={{ position: "absolute", inset: 0, width: "100%", height: "100%", zIndex: 3 }}
      />

      {/* UI Chrome */}
      <div
        style={{
          position: "absolute",
          inset: 0,
          zIndex: 4,
          pointerEvents: "none",
          fontFamily: "'Helvetica Neue', Helvetica, Arial, sans-serif",
        }}
      >
        {/* Corner brackets */}
        {[
          { top: 24, left: 24, borderWidth: "1px 0 0 1px" },
          { top: 24, right: 24, borderWidth: "1px 1px 0 0" },
          { bottom: 24, left: 24, borderWidth: "0 0 1px 1px" },
          { bottom: 24, right: 24, borderWidth: "0 1px 1px 0" },
        ].map((s, i) => (
          <div
            key={i}
            style={{
              position: "absolute",
              width: 22,
              height: 22,
              borderColor: "rgba(255,255,255,0.18)",
              borderStyle: "solid",
              ...s,
            }}
          />
        ))}

        {/* Top labels */}
        <div style={{ position: "absolute", top: 26, left: 54, color: "rgba(255,255,255,0.2)", fontSize: 9, letterSpacing: "3px", textTransform: "uppercase" }}>
          Portfolio · 2026
        </div>
        <div style={{ position: "absolute", top: 26, right: 54, color: "rgba(255,255,255,0.2)", fontSize: 9, letterSpacing: "3px", textTransform: "uppercase" }}>
          Kalaburagi, IN
        </div>

        {/* Tagline above name */}
        <div style={{
          position: "absolute",
          top: "50%",
          left: "50%",
          transform: "translate(-50%, -110px)",
          whiteSpace: "nowrap",
          color: "rgba(255,255,255,0.28)",
          fontSize: 10,
          letterSpacing: "5px",
          textTransform: "uppercase",
        }}>
          Video Editor&nbsp;&nbsp;
          <span style={{ color: "rgba(255,110,60,0.8)" }}>✦</span>
          &nbsp;&nbsp;Motion Designer
        </div>

        {/* Subtitle below name */}
        <div style={{
          position: "absolute",
          top: "50%",
          left: "50%",
          transform: "translate(-50%, 78px)",
          whiteSpace: "nowrap",
          color: "rgba(255,255,255,0.18)",
          fontSize: 10,
          letterSpacing: "4px",
          textTransform: "uppercase",
        }}>
          Cinematic Reels
          <span style={{ color: "rgba(255,255,255,0.08)", margin: "0 12px" }}>—</span>
          Color Grading
          <span style={{ color: "rgba(255,255,255,0.08)", margin: "0 12px" }}>—</span>
          Motion Graphics
        </div>

        {/* Horizontal dividers */}
        {["calc(50% - 130px)", "calc(50% + 130px)"].map((top, i) => (
          <div
            key={i}
            style={{
              position: "absolute",
              top,
              left: 60,
              right: 60,
              height: "0.5px",
              background: "rgba(255,255,255,0.05)",
            }}
          />
        ))}

        {/* Bottom badges */}
        <div style={{
          position: "absolute",
          bottom: 36,
          left: "50%",
          transform: "translateX(-50%)",
          display: "flex",
          gap: 8,
        }}>
          {["Instagram", "YouTube", "Brand Films", "Color Grading"].map((b) => (
            <div
              key={b}
              style={{
                background: "rgba(255,255,255,0.03)",
                border: "0.5px solid rgba(255,255,255,0.1)",
                color: "rgba(255,255,255,0.3)",
                fontSize: 8,
                letterSpacing: "2.5px",
                padding: "5px 14px",
                borderRadius: 2,
                textTransform: "uppercase",
                whiteSpace: "nowrap",
              }}
            >
              {b}
            </div>
          ))}
        </div>

        {/* Bottom left CTA */}
        <a
          href="#experience"
          style={{
            position: "absolute",
            bottom: 36,
            left: 28,
            color: "rgba(255,255,255,0.2)",
            fontSize: 9,
            letterSpacing: "2.5px",
            textTransform: "uppercase",
            textDecoration: "none",
            pointerEvents: "all",
            cursor: "pointer",
          }}
        >
          ↓ View Works
        </a>

        {/* Bottom right */}
        <div style={{ position: "absolute", bottom: 36, right: 28, color: "rgba(255,255,255,0.12)", fontSize: 9, letterSpacing: "2px" }}>
          © CM
        </div>
      </div>

      {/* Custom cursor dot */}
      <style>{`
        .hero-section { cursor: none; }
        .hero-section * { cursor: none; }
        .hero-cursor {
          position: fixed;
          width: 6px;
          height: 6px;
          background: #fff;
          border-radius: 50%;
          pointer-events: none;
          z-index: 9999;
          transform: translate(-50%, -50%);
          mix-blend-mode: difference;
          transition: transform 0.05s;
        }
        .hero-cursor-ring {
          position: fixed;
          width: 32px;
          height: 32px;
          border: 0.5px solid rgba(255,255,255,0.3);
          border-radius: 50%;
          pointer-events: none;
          z-index: 9998;
          transform: translate(-50%, -50%);
          transition: left 0.12s ease, top 0.12s ease;
        }
      `}</style>
    </section>
  );
}